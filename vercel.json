{
  "version": 2,
  "builds": [
    { "src": "API/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/API/$1" },
    { "src": "/admin", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }, "dest": "/public/admin.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
